{
  "kind": "collectionType",
  "collectionName": "master_settings",
  "info": {
    "singularName": "master-setting",
    "pluralName": "master-settings",
    "displayName": "Master Setting"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "key": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "value": {
      "type": "json"
    },
    "description": {
      "type": "text"
    },
    "type": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "company": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::company.company"
    }
  }
}
